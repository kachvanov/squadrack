# Settings of this deployment, read by up.sh. No secrets here: they live in SQUADRACK_SECRETS.
# Relative paths are relative to this directory.

# Product version: a tag of github.com/kachvanov/squadrack. To upgrade, change it and run ./up.sh
SQUADRACK_VERSION=v0.4.0

# Clone of the product, secrets file (template: stack/.env.example of the product)
# and the directory for service data (pg/ and s3/ inside)
SQUADRACK_DIR=../squadrack
SQUADRACK_SECRETS=../.env
SQUADRACK_DATA_DIR=../data

# Optional: the directory of project services, <project>/secrets/ inside. `./up.sh access project-key`
# writes the S3 key of a project there. Readable by the admins only; create it once by hand.
SQUADRACK_PROJECTS_DIR=../projects

# Compose project name: prefix of container, network and volume names
SQUADRACK_PROJECT=demo

# Host ports, always bound to 127.0.0.1
MLFLOW_PORT=5000
S3_PORT=8333
S3_ADMIN_UI_PORT=12535

# Prefix for docker: empty, or `sudo` when this user is not in the docker group
SUDO=
