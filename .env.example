# Client settings for scripts/ and examples/: boto3 and mlflow read these variables themselves.
# Copy to `.env` in the repo root (never commit it), fill in the secrets and run:
#   uv run --env-file .env scripts/s3_check.py

# S3 API of the stack: the port published on the host.
# From a container inside the stack use http://s3:8333 instead.
AWS_ENDPOINT_URL=http://localhost:8333

# S3 key. For now the admin key: same values as S3_ADMIN_ACCESS_KEY and S3_ADMIN_SECRET_KEY in stack/.env
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# MLflow tracking server. Artifacts go through the server, so MLflow clients need no S3 key.
MLFLOW_TRACKING_URI=http://localhost:5000

# No usage reports from the MLflow client to mlflow-telemetry.io
MLFLOW_DISABLE_TELEMETRY=true

# MLflow login. For now the admin: same password as MLFLOW_ADMIN_PASSWORD in stack/.env
MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=change-me
