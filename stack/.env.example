# Copy to `.env` next to the stack (never commit it) and fill in real values.
# In each block settings go first, secrets last. Generate secrets with: openssl rand -hex 32
# Scripts on the host take their S3 settings from ../.env (see ../.env.example).

# Postgres
POSTGRES_USER=mlflow
POSTGRES_DB=mlflow
POSTGRES_PASSWORD=change-me

# SeaweedFS: admin S3 key and Admin UI password
S3_ADMIN_ACCESS_KEY=change-me
S3_ADMIN_SECRET_KEY=change-me
S3_ADMIN_UI_PASSWORD=change-me

# MLflow: password of the `admin` user (at least 12 characters, used on the first start only)
# and the secret key for CSRF protection of the login and signup forms
MLFLOW_ADMIN_PASSWORD=change-me-at-least-12-chars
MLFLOW_SECRET_KEY=change-me
