# S3 client settings for scripts/ and examples/. boto3 reads these AWS_* variables itself.
# Copy to `.env` in the repo root (never commit it), fill in the keys and run:
#   uv run --env-file .env scripts/s3_check.py

# S3 API of the stack: the port published on the host.
# From a container inside the stack use http://s3:8333 instead.
AWS_ENDPOINT_URL=http://localhost:8333

# S3 key. For now the admin key: same values as S3_ADMIN_ACCESS_KEY and S3_ADMIN_SECRET_KEY in stack/.env
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
